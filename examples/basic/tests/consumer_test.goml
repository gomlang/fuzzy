package tests;

use ecosystem::fuzzy;
use std::testing;
use std::context;
use ecosystem::fuzzy::examples::basic as app;

#[test]
fn versioned_file_picker() -> () {
    app::exercise();
}

#[test]
fn impossible_match_respects_public_preparation_and_work_limits() -> () {
    let matcher = testing::expect_ok(
        fuzzy::Matcher::new(fuzzy::Options { max_cells: 1, ..fuzzy::Options::new() }),
        "matcher",
    );
    testing::assert(
        testing::expect_ok(matcher.find("missing", "xxxxxxxxxxxxxxxx"), "no match").is_none(),
    );
}

#[test]
fn public_topk_returns_stable_score_order() -> () {
    let matcher = testing::expect_ok(fuzzy::Matcher::new(fuzzy::Options::new()), "matcher");
    let result = testing::expect_ok(
        matcher.search("a", Vec::from_array(["zzza", "a", "a"]), 2, context::Context::background()),
        "topk",
    );
    testing::assert_eq(result.hits[0].index, 1);
    testing::assert_eq(result.hits[1].index, 2);
}

#[test]
fn anchored_matches_preserve_folded_grapheme_highlights() -> () {
    let matcher = testing::expect_ok(fuzzy::Matcher::new(fuzzy::Options::new()), "matcher");
    let found = testing::expect_some(
        testing::expect_ok(
            matcher.find_with("ss", "ßx", fuzzy::MatchKind::Prefix, context::Context::background()),
            "folded prefix",
        ),
        "matching prefix",
    );
    testing::assert_eq(found.score, 52);
    testing::assert(found.ranges == Vec::from_array([fuzzy::Range { start: 0, end: 2 }]));
    testing::assert(found.graphemes == Vec::from_array([0]));
}

#[test]
fn substring_search_keeps_boundary_scores_and_earliest_ties() -> () {
    let matcher = testing::expect_ok(fuzzy::Matcher::new(fuzzy::Options::new()), "matcher");
    let ctx = context::Context::background();
    let found = testing::expect_some(
        testing::expect_ok(
            matcher.find_with("ab", "xabab/ab", fuzzy::MatchKind::Substring, ctx),
            "substring",
        ),
        "matching substring",
    );
    testing::assert_eq(found.score, 48);
    testing::assert(found.ranges == Vec::from_array([fuzzy::Range { start: 6, end: 8 }]));
    let tied = testing::expect_some(
        testing::expect_ok(
            matcher.find_with("x", "xa/xa", fuzzy::MatchKind::Substring, ctx),
            "tied substring",
        ),
        "matching tie",
    );
    testing::assert_eq(tied.score, 27);
    testing::assert(found.graphemes == Vec::from_array([6, 7]));
    testing::assert(tied.ranges == Vec::from_array([fuzzy::Range { start: 0, end: 1 }]));
}
