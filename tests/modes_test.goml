package tests;

use ecosystem::fuzzy;
use std::context;
use std::testing;

fn matching_modes() -> Vec[fuzzy::MatchKind] {
    Vec::from_array(
        [
            fuzzy::MatchKind::Fuzzy,
            fuzzy::MatchKind::Substring,
            fuzzy::MatchKind::Prefix,
            fuzzy::MatchKind::Suffix,
            fuzzy::MatchKind::Exact,
        ],
    )
}

fn assert_mode_report(
    matcher: fuzzy::Matcher,
    values: Vec[string],
    query: string,
    kind: fuzzy::MatchKind,
    report: fuzzy::Report,
    limit: isize,
) -> () {
    let expected = Vec::new();
    for index in 0..values.len() {
        if let Some(matched) = testing::expect_ok(
            matcher.find_with(query, values[index], kind, context::Context::background()),
            "single match",
        ) {
            expected.push(fuzzy::Hit { index, text: values[index], matched });
        }
    }
    expected.sort_by(
        |a, b| if a.matched.score > b.matched.score {
            -1
        } else if a.matched.score < b.matched.score {
            1
        } else {
            a.index - b.index
        },
    );
    testing::assert_eq(report.total, expected.len());
    let count = if limit < expected.len() {
        limit
    } else {
        expected.len()
    };
    testing::assert_eq(report.hits.len(), count);
    for index in 0..count {
        testing::assert_eq(report.hits[index].index, expected[index].index);
        testing::assert_eq(report.hits[index].text, expected[index].text);
        testing::assert_eq(report.hits[index].matched.score, expected[index].matched.score);
        testing::assert(report.hits[index].matched.ranges == expected[index].matched.ranges);
        testing::assert(report.hits[index].matched.graphemes == expected[index].matched.graphemes);
    }
}

#[test]
fn every_collection_mode_matches_single_candidate_ranking_and_parallel_results() -> () {
    let values = Vec::from_array(
        ["", "abc", "abc", "xab", "abx", "a_b", "Straße", "strasse", "🇨🇳a", "ábc", "ABC"],
    );
    for case_mode in[fuzzy::CaseMode::Sensitive, fuzzy::CaseMode::Fold, fuzzy::CaseMode::Smart] {
        let matcher = testing::expect_ok(
            fuzzy::Matcher::new(fuzzy::Options { case_mode, ..fuzzy::Options::new() }),
            "matcher",
        );
        for kind in matching_modes() {
            for query in["", "ab", "a", "ss", "STRASSE", "🇨🇳"] {
                for limit in[0, 1, 3, 20] {
                    let serial = testing::expect_ok(
                        matcher.search_with(
                            query,
                            values,
                            kind,
                            limit,
                            context::Context::background(),
                        ),
                        "serial",
                    );
                    let parallel = testing::expect_ok(
                        matcher.search_parallel_with(
                            query,
                            values,
                            kind,
                            limit,
                            3,
                            context::Context::background(),
                        ),
                        "parallel",
                    );
                    assert_mode_report(matcher, values, query, kind, serial, limit);
                    assert_mode_report(matcher, values, query, kind, parallel, limit);
                    testing::assert_eq(serial.scanned, values.len());
                    testing::assert_eq(parallel.scanned, values.len());
                }
            }
        }
    }
}

#[test]
fn persistent_sessions_rescan_on_mode_switches_and_only_narrow_safe_extensions() -> () {
    let matcher = testing::expect_ok(fuzzy::Matcher::new(fuzzy::Options::new()), "matcher");
    let values = Vec::from_array(["a", "ab", "ba", "cab", "ABC", "zz", "", "a_b"]);
    let initial = testing::expect_ok(fuzzy::Session::new(matcher, values), "session");
    for previous_kind in matching_modes() {
        for previous_query in["", "a", "ab", "b", "A"] {
            let (session, _) = testing::expect_ok(
                initial.update_with(
                    previous_query,
                    previous_kind,
                    0,
                    context::Context::background(),
                ),
                "initial mode",
            );
            for kind in matching_modes() {
                for query in["", "a", "ab", "ba", "b", "A"] {
                    let (_, report) = testing::expect_ok(
                        session.update_with(query, kind, 20, context::Context::background()),
                        "mode transition",
                    );
                    assert_mode_report(matcher, values, query, kind, report, 20);
                    if kind != previous_kind {
                        testing::assert_eq(report.scanned, values.len());
                    }
                }
            }
        }
    }
    let (suffix, before) = testing::expect_ok(
        initial.update_with("b", fuzzy::MatchKind::Suffix, 0, context::Context::background()),
        "suffix",
    );
    let (_, narrowed) = testing::expect_ok(
        suffix.update_with("ab", fuzzy::MatchKind::Suffix, 20, context::Context::background()),
        "prepend suffix",
    );
    testing::assert_eq(narrowed.scanned, before.total);
    let (_, widened) = testing::expect_ok(
        suffix.update_with("ba", fuzzy::MatchKind::Suffix, 20, context::Context::background()),
        "append suffix",
    );
    testing::assert_eq(widened.scanned, values.len());
    let (_, legacy) = testing::expect_ok(
        suffix.update("ab", 20, context::Context::background()),
        "legacy default",
    );
    assert_mode_report(matcher, values, "ab", fuzzy::MatchKind::Fuzzy, legacy, 20);
}

#[test]
fn collection_modes_keep_budgets_context_checks_and_failed_session_reuse() -> () {
    let matcher = testing::expect_ok(
        fuzzy::Matcher::new(
            fuzzy::Options {
                max_bytes: 4,
                max_units: 4,
                max_pattern_units: 2,
                max_results: 2,
                ..fuzzy::Options::new(),
            },
        ),
        "limited",
    );
    let values = Vec::from_array(["ab", "ba"]);
    let session = testing::expect_ok(fuzzy::Session::new(matcher, values), "session");
    for kind in matching_modes() {
        testing::assert_eq(
            testing::expect_err(
                session.update_with("abc", kind, 1, context::Context::background()),
                "pattern limit",
            ),
            fuzzy::Error::PatternLimit,
        );
        testing::assert_eq(
            testing::expect_err(
                session.update_with("a", kind, 3, context::Context::background()),
                "result limit",
            ),
            fuzzy::Error::InvalidLimit,
        );
        testing::assert_eq(
            testing::expect_err(
                matcher.search_parallel_with(
                    "",
                    Vec::from_array(["large"]),
                    kind,
                    0,
                    2,
                    context::Context::background(),
                ),
                "candidate limit",
            ),
            fuzzy::Error::InputLimit,
        );
        testing::assert_eq(
            testing::expect_err(
                matcher.search_parallel_with("", values, kind, 1, 0, context::Context::background()),
                "workers",
            ),
            fuzzy::Error::InvalidLimit,
        );
        context::with_cancel(
            context::Context::background(),
            |ctx, cancel| {
                cancel.cancel();
                testing::assert_eq(
                    testing::expect_err(session.update_with("a", kind, 1, ctx), "cancelled"),
                    fuzzy::Error::Cancelled,
                );
            },
        );
        let (_, report) = testing::expect_ok(
            session.update_with("a", kind, 2, context::Context::background()),
            "reuse after errors",
        );
        assert_mode_report(matcher, values, "a", kind, report, 2);
    }
}
