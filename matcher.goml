package fuzzy;

use ecosystem::unicode_text;
use std::context;
use std::unicode;

const MISSING: isize = -1000000000;

fn first_scalar(value: string) -> char {
    for ch in value.chars() {
        return ch;
    }
    '\u0000'
}

fn boundary_bonus(previous: char, current: char, first: bool, paths: bool) -> isize {
    if first {
        12
    } else if paths && (previous == '/' || previous == '\\') {
        14
    } else if !unicode::is_letter(previous) && !unicode::is_number(previous) {
        10
    } else if unicode::is_lowercase(previous) && unicode::is_uppercase(current) {
        8
    } else {
        0
    }
}

fn insensitive(mode: CaseMode, pattern: string) -> bool {
    if mode == CaseMode::Sensitive {
        return false;
    }
    if mode == CaseMode::Smart {
        for ch in pattern.chars() {
            if unicode::is_uppercase(ch) {
                return false;
            }
        }
    }
    true
}

fn filled[T](size: isize, value: T) -> Vec[T] {
    let output = Vec::with_capacity(size);
    for _ in 0..size {
        output.push(value);
    }
    output
}

fn contiguous_match(source: Vec[Unit], start: isize, count: isize, score: isize) -> Match {
    let graphemes = Vec::new();
    for row in 0..count {
        let unit = source[start + row];
        if graphemes.last() != Option::Some(unit.grapheme) {
            graphemes.push(unit.grapheme);
        }
    }
    Match {
        score,
        ranges: Vec::from_array(
            [Range { start: source[start].start, end: source[start + count - 1].end }],
        ),
        graphemes,
    }
}

fn anchored_match(pattern: Pattern, source: Vec[Unit], ctx: context::Context) -> Result[
    Option[Match],
    Error,
] {
    let count = pattern.units.len();
    let start = if pattern.kind == MatchKind::Suffix {
        source.len() - count
    } else {
        0
    };
    let mut score = -start - (source.len() - start - count) / 4;
    for row in 0..count {
        if row % 1024 == 0 {
            check_context(ctx)?;
        }
        let unit = source[start + row];
        if pattern.units[row] != unit.value {
            return Result::Ok(Option::None);
        }
        score += 16 + unit.bonus;
        if row > 0 {
            score += 8;
        }
    }
    check_context(ctx)?;
    Result::Ok(Option::Some(contiguous_match(source, start, count, score)))
}

fn substring_match(pattern: Pattern, source: Vec[Unit], ctx: context::Context) -> Result[
    Option[Match],
    Error,
] {
    let count = pattern.units.len();
    let fallback = filled(count, 0);
    let mut matched = 0;
    for index in 1..count {
        if index % 1024 == 0 {
            check_context(ctx)?;
        }
        while matched > 0 && pattern.units[matched] != pattern.units[index] {
            matched = fallback[matched - 1];
        }
        if pattern.units[matched] == pattern.units[index] {
            matched += 1;
        }
        fallback[index] = matched;
    }
    matched = 0;
    let mut bonus = 0;
    let mut best = MISSING;
    let mut best_start = -1;
    for column in 0..source.len() {
        if column % 1024 == 0 {
            check_context(ctx)?;
        }
        bonus += source[column].bonus;
        if column >= count {
            bonus -= source[column - count].bonus;
        }
        while matched > 0 && pattern.units[matched] != source[column].value {
            matched = fallback[matched - 1];
        }
        if pattern.units[matched] == source[column].value {
            matched += 1;
        }
        if matched == count {
            let start = column - count + 1;
            let score = 16 * count + 8 * (count - 1) + bonus - start
                - (source.len() - column - 1) / 4;
            if score > best {
                best = score;
                best_start = start;
            }
            matched = fallback[count - 1];
        }
    }
    check_context(ctx)?;
    if best_start < 0 {
        Result::Ok(Option::None)
    } else {
        Result::Ok(Option::Some(contiguous_match(source, best_start, count, best)))
    }
}

impl Matcher {
    pub fn new(options: Options) -> Result[Matcher, Error] {
        if options.max_bytes < 1 || options.max_bytes > 16777216 || options.max_units < 1
            || options.max_units > 1048576
            || options.max_pattern_units < 1
            || options.max_pattern_units > 4096
            || options.max_cells < 1
            || options.max_cells > 67108864
            || options.max_results < 1
            || options.max_results > 1000000 {
            return Result::Err(Error::InvalidOptions);
        }
        Result::Ok(Matcher { options })
    }

    pub fn prepare(self: Matcher, value: string) -> Result[Candidate, Error] {
        if value.byte_len() > self.options.max_bytes {
            return Result::Err(Error::InputLimit);
        }
        let sensitive = Vec::new();
        let folded = Vec::new();
        let mut previous = '\u0000';
        let mut index = 0;
        for cluster in unicode_text::graphemes(value) {
            let current = first_scalar(cluster.text);
            let bonus = boundary_bonus(previous, current, index == 0, self.options.path_bonus);
            let mut first = true;
            for ch in cluster.text.chars() {
                sensitive.push(
                    Unit {
                        value: ch,
                        start: cluster.start,
                        end: cluster.end,
                        grapheme: index,
                        bonus: if first {
                            bonus
                        } else {
                            0
                        },
                    },
                );
                first = false;
                previous = ch;
            }
            first = true;
            for ch in unicode::case_fold(cluster.text).chars() {
                folded.push(
                    Unit {
                        value: ch,
                        start: cluster.start,
                        end: cluster.end,
                        grapheme: index,
                        bonus: if first {
                            bonus
                        } else {
                            0
                        },
                    },
                );
                first = false;
            }
            if sensitive.len() > self.options.max_units || folded.len() > self.options.max_units {
                return Result::Err(Error::InputLimit);
            }
            index += 1;
        }
        Result::Ok(Candidate { value, sensitive, folded, path_bonus: self.options.path_bonus })
    }

    pub fn pattern(self: Matcher, value: string, kind: MatchKind) -> Result[Pattern, Error] {
        if value.byte_len() > self.options.max_bytes {
            return Result::Err(Error::PatternLimit);
        }
        let sensitive = !insensitive(self.options.case_mode, value);
        let normalized = if sensitive {
            value
        } else {
            unicode::case_fold(value)
        };
        let units = Vec::new();
        for ch in normalized.chars() {
            units.push(ch);
            if units.len() > self.options.max_pattern_units {
                return Result::Err(Error::PatternLimit);
            }
        }
        Result::Ok(Pattern { value, units, sensitive, kind, case_mode: self.options.case_mode })
    }

    pub fn find(self: Matcher, query: string, value: string) -> Result[Option[Match], Error] {
        self.find_with(query, value, MatchKind::Fuzzy, context::Context::background())
    }

    pub fn find_with(
        self: Matcher,
        query: string,
        value: string,
        kind: MatchKind,
        ctx: context::Context,
    ) -> Result[Option[Match], Error] {
        check_context(ctx)?;
        self.match_prepared(self.pattern(query, kind)?, self.prepare(value)?, ctx)
    }

    pub fn match_prepared(
        self: Matcher,
        pattern: Pattern,
        candidate: Candidate,
        ctx: context::Context,
    ) -> Result[Option[Match], Error] {
        check_context(ctx)?;
        if candidate.value.byte_len() > self.options.max_bytes
            || candidate.sensitive.len() > self.options.max_units
            || candidate.folded.len() > self.options.max_units {
            return Result::Err(Error::InputLimit);
        }
        if pattern.value.byte_len() > self.options.max_bytes
            || pattern.units.len() > self.options.max_pattern_units {
            return Result::Err(Error::PatternLimit);
        }
        if candidate.path_bonus != self.options.path_bonus
            || pattern.case_mode != self.options.case_mode {
            return Result::Err(Error::IncompatiblePreparation);
        }
        let source = if pattern.sensitive {
            candidate.sensitive
        } else {
            candidate.folded
        };
        let rows = pattern.units.len();
        let columns = source.len();
        if rows == 0 {
            if pattern.kind == MatchKind::Exact && columns != 0 {
                return Result::Ok(Option::None);
            }
            return Result::Ok(
                Option::Some(Match { score: 0, ranges: Vec::new(), graphemes: Vec::new() }),
            );
        }
        if rows > columns || (pattern.kind == MatchKind::Exact && rows != columns) {
            return Result::Ok(Option::None);
        }
        let mut matched_units = 0;
        for column in 0..columns {
            if column % 1024 == 0 {
                check_context(ctx)?;
            }
            if pattern.units[matched_units] == source[column].value {
                matched_units += 1;
                if matched_units == rows {
                    break;
                }
            }
        }
        if matched_units != rows {
            return Result::Ok(Option::None);
        }
        if columns > self.options.max_cells / rows {
            return Result::Err(Error::WorkLimit);
        }
        if pattern.kind == MatchKind::Prefix || pattern.kind == MatchKind::Suffix
            || pattern.kind == MatchKind::Exact {
            return anchored_match(pattern, source, ctx);
        }
        if pattern.kind == MatchKind::Substring {
            return substring_match(pattern, source, ctx);
        }
        let parents: Vec[i32] = filled(rows * columns, -1);
        let mut previous = filled(columns, MISSING);
        let mut current = filled(columns, MISSING);
        for row in 0..rows {
            check_context(ctx)?;
            let mut best_gap = MISSING;
            let mut best_parent = -1;
            for column in 0..columns {
                if column % 1024 == 0 {
                    check_context(ctx)?;
                }
                current[column] = MISSING;
                if row > 0 && column >= 2 && previous[column - 2] != MISSING {
                    let score = previous[column - 2] + column - 2;
                    if score > best_gap {
                        best_gap = score;
                        best_parent = column - 2;
                    }
                }
                if pattern.units[row] != source[column].value {
                    continue;
                }
                let reward = 16 + source[column].bonus;
                if row == 0 {
                    if column == 0
                        || (pattern.kind != MatchKind::Prefix && pattern.kind != MatchKind::Exact) {
                        current[column] = reward - column;
                    }
                } else {
                    let mut score = MISSING;
                    let mut parent = -1;
                    if pattern.kind == MatchKind::Fuzzy && best_gap != MISSING {
                        score = best_gap - (column - 1) - 3;
                        parent = best_parent;
                    }
                    if column > 0 && previous[column - 1] != MISSING {
                        let adjacent = previous[column - 1] + 8;
                        if adjacent > score {
                            score = adjacent;
                            parent = column - 1;
                        }
                    }
                    if parent >= 0 {
                        current[column] = score + reward;
                        parents[row * columns + column] = parent.to_i32();
                    }
                }
            }
            let swap = previous;
            previous = current;
            current = swap;
        }
        let mut best = MISSING;
        let mut end = -1;
        for column in 0..columns {
            if previous[column] == MISSING {
                continue;
            }
            if (pattern.kind == MatchKind::Suffix || pattern.kind == MatchKind::Exact)
                && column != columns - 1 {
                continue;
            }
            let score = previous[column] - (columns - column - 1) / 4;
            if score > best {
                best = score;
                end = column;
            }
        }
        if end < 0 {
            return Result::Ok(Option::None);
        }
        let chosen = Vec::new();
        let mut row = rows - 1;
        while row >= 0 {
            chosen.push(source[end]);
            end = parents[row * columns + end].to_isize();
            row -= 1;
        }
        chosen.reverse();
        let ranges: Vec[Range] = Vec::new();
        let graphemes = Vec::new();
        for unit in chosen {
            if graphemes.last() != Option::Some(unit.grapheme) {
                graphemes.push(unit.grapheme);
            }
            match ranges.last() {
                Some(last) => if unit.start <= last.end {
                    ranges[ranges.len() - 1] = Range { start: last.start, end: unit.end };
                } else {
                    ranges.push(Range { start: unit.start, end: unit.end });
                },
                None => ranges.push(Range { start: unit.start, end: unit.end }),
            }
        }
        Result::Ok(Option::Some(Match { score: best, ranges, graphemes }))
    }
}
